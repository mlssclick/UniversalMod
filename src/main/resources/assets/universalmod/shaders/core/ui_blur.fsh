#version 150
in vec2 FragCoord;in vec4 FragColor;uniform sampler2D Sampler0;uniform vec2 Size;uniform vec4 Radius;uniform float Smoothness;uniform float VerticalSplit;uniform vec4 SplitColor;uniform vec4 BlurRegion;out vec4 OutColor;
float rdist(vec2 pos,vec2 size,vec4 radius){float cr;if(pos.x>0)cr=(pos.y>0)?radius.x:radius.w;else cr=(pos.y>0)?radius.y:radius.z;vec2 v=abs(pos)-size+cr;return min(max(v.x,v.y),0)+length(max(v,0))-cr;}
float ralpha(vec2 size,vec2 coord,vec4 radius,float sm){vec2 center=size*.5;float f=max(sm,.001);float d=rdist(center-coord*size,max(center-1,vec2(0)),max(radius,vec4(0)));return 1-smoothstep(1-f,1,d);}
void main(){vec2 texCoord=clamp((gl_FragCoord.xy-BlurRegion.xy)/max(BlurRegion.zw,vec2(1)),vec2(0),vec2(1));vec3 blurred=texture(Sampler0,texCoord).rgb;vec4 tint=FragColor;if(VerticalSplit>=0.0 && FragCoord.y*Size.y<VerticalSplit) tint=SplitColor;float tintStrength=clamp(tint.a*(1.0-dot(tint.rgb,vec3(.299,.587,.114)))*.72,0,.82);vec4 color=vec4(mix(blurred,tint.rgb,tintStrength),tint.a);color.a*=ralpha(max(Size,vec2(1)),FragCoord,max(Radius,vec4(0)),Smoothness);if(color.a==0.0)discard;OutColor=color;}
