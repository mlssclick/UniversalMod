#version 150
in vec2 FragCoord;uniform sampler2D Sampler0;uniform vec2 Size;uniform vec4 Radius;uniform float Smoothness;uniform vec4 BlurRegion;uniform float GlobalAlpha;uniform float FresnelPower;uniform vec4 FresnelColor;uniform float BaseAlpha;uniform float FresnelInvert;uniform float FresnelMix;uniform float DistortStrength;out vec4 OutColor;
float rdist(vec2 pos,vec2 size,vec4 radius){float cr;if(pos.x>0)cr=(pos.y>0)?radius.x:radius.w;else cr=(pos.y>0)?radius.y:radius.z;vec2 v=abs(pos)-size+cr;return min(max(v.x,v.y),0)+length(max(v,0))-cr;}
float ralpha(vec2 size,vec2 coord,vec4 radius,float sm){vec2 center=size*.5;float f=max(sm,.001);float d=rdist(center-coord*size,max(center-1,vec2(0)),max(radius,vec4(0)));return 1-smoothstep(1-f,1,d);}
void main(){vec2 coord=clamp(FragCoord,vec2(0),vec2(1));vec2 size=max(Size,vec2(1));vec2 center=size*.5;vec2 halfSize=max(center-1,vec2(0));vec2 pos=center-coord*size;float alpha=ralpha(size,coord,max(Radius,vec4(0)),Smoothness);float distToEdge=abs(rdist(pos,halfSize,max(Radius,vec4(0))));float maxDistNorm=max(min(halfSize.x,halfSize.y),.001);float edgeGradient=1-clamp(distToEdge/maxDistNorm,0,1);float fresnelBase=FresnelInvert>.5?edgeGradient:1-edgeGradient;float fresnel=FresnelPower>20?exp(FresnelPower*log(clamp(fresnelBase,.001,1))):pow(clamp(fresnelBase,0,1),FresnelPower);fresnel=clamp(fresnel,0,1);vec2 dir=length(pos)>.001?normalize(-pos):vec2(0);vec2 texCoord=clamp((gl_FragCoord.xy-BlurRegion.xy)/max(BlurRegion.zw,vec2(1)),vec2(0),vec2(1));vec4 texColor=texture(Sampler0,clamp(texCoord+dir*fresnel*DistortStrength,vec2(0),vec2(1)));vec3 finalColor=mix(texColor.rgb,FresnelColor.rgb,fresnel*FresnelMix);float finalAlpha=mix(BaseAlpha,FresnelColor.a,fresnel)*alpha*GlobalAlpha;if(finalAlpha<.001)discard;OutColor=vec4(finalColor,finalAlpha);}
