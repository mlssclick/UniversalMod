#version 150
in vec2 FragCoord;uniform sampler2D Sampler0;uniform vec2 Size;uniform vec4 Radius;uniform float Smoothness;uniform vec4 BlurRegion;uniform float Thickness;uniform float GlobalAlpha;uniform float FresnelPower;uniform vec4 FresnelColor;uniform float BaseAlpha;uniform float FresnelInvert;uniform float FresnelMix;uniform float DistortStrength;uniform float ShinePhase;uniform vec4 TintColor;out vec4 OutColor;
float rdist(vec2 pos,vec2 size,vec4 radius){float cr;if(pos.x>0)cr=(pos.y>0)?radius.x:radius.w;else cr=(pos.y>0)?radius.y:radius.z;vec2 v=abs(pos)-size+cr;return min(max(v.x,v.y),0)+length(max(v,0))-cr;}
float ralpha(vec2 size,vec2 coord,vec4 radius,float sm){vec2 center=size*.5;float f=max(sm,.001);float d=rdist(center-coord*size,max(center-1,vec2(0)),max(radius,vec4(0)));return 1-smoothstep(1-f,1,d);}
float oa(vec2 coord,vec2 size,vec4 radius,float th,float sm){float outer=ralpha(size,coord,radius,sm);vec2 innerSize=size-vec2(th*2);if(innerSize.x<=0||innerSize.y<=0)return outer;vec2 local=coord*size;vec2 innerCoord=(local-vec2(th))/innerSize;float inner=ralpha(innerSize,innerCoord,max(radius-vec4(th),vec4(0)),sm);return clamp(outer-inner,0,1);}
void main(){vec2 coord=clamp(FragCoord,vec2(0),vec2(1));vec2 size=max(Size,vec2(1));float thickness=max(Thickness,0);float alpha=oa(coord,size,max(Radius,vec4(0)),thickness,max(Smoothness,.001));vec2 center=size*.5,halfSize=max(center-1,vec2(0)),pos=center-coord*size;float distToEdge=abs(rdist(pos,halfSize,max(Radius,vec4(0))));float md=max(min(halfSize.x,halfSize.y),.001);float eg=1-clamp(distToEdge/md,0,1);float fb=FresnelInvert>.5?eg:1-eg;float fr=FresnelPower>20?exp(FresnelPower*log(clamp(fb,.001,1))):pow(clamp(fb,0,1),FresnelPower);fr=clamp(fr,0,1);vec2 dir=length(pos)>.001?normalize(-pos):vec2(0);vec2 texCoord=clamp((gl_FragCoord.xy-BlurRegion.xy)/max(BlurRegion.zw,vec2(1)),vec2(0),vec2(1));vec4 texColor=texture(Sampler0,clamp(texCoord+dir*fr*DistortStrength,vec2(0),vec2(1)));vec3 tinted=mix(texColor.rgb,TintColor.rgb,clamp(TintColor.a,0,1)*.65);vec3 finalColor=mix(tinted,FresnelColor.rgb,fr*FresnelMix);float finalAlpha=mix(BaseAlpha,max(FresnelColor.a,TintColor.a),fr)*alpha*GlobalAlpha;if(ShinePhase<.999){float dt=coord.y,dr=1-coord.x,db=1-coord.y,dl=coord.x;float tm=step(dt,dr)*step(dt,db)*step(dt,dl),rm=step(dr,dt)*step(dr,db)*step(dr,dl),bm=step(db,dt)*step(db,dr)*step(db,dl),lm=step(dl,dt)*step(dl,dr)*step(dl,db);float pa=tm*(coord.x*.5)+rm*(.5+coord.y*.5),ma=clamp(tm+rm,0,1),pb=lm*(coord.y*.5)+bm*(.5+coord.x*.5),mb=clamp(lm+bm,0,1);float cent=ShinePhase*1.34-.17,cf=smoothstep(0,.14,ShinePhase)*(1-smoothstep(.86,1,ShinePhase));float sa=smoothstep(.18,0,abs(pa-cent))*ma,sb=smoothstep(.16,0,abs(pb-cent))*mb,of=clamp(max(max(TintColor.a,FresnelColor.a),BaseAlpha)*GlobalAlpha,0,1),shine=max(sa,sb*.9)*cf*alpha*of;finalColor=mix(finalColor,vec3(1),shine*.78);finalAlpha=max(finalAlpha,shine*.66);}if(finalAlpha<.001)discard;OutColor=vec4(finalColor,finalAlpha);}
